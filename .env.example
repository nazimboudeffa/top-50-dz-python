# Configuration locale — copier ce fichier en « .env » puis le remplir.
# « .env » est ignoré par git : les secrets ne doivent jamais être versionnés.

# ---------------------------------------------------------------------------
# Spotify (facultatif — utilisé par build_playlist.py --isrc uniquement)
# 1. Créer une application : https://developer.spotify.com/dashboard
# 2. Copier le Client ID et le Client Secret ci-dessous.
#
# Depuis février 2026, une application en Development Mode exige que son
# propriétaire ait un abonnement Spotify Premium.
# ---------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# YouTube Data API v3 (recommandé — seule source de vues réelles)
# 1. https://console.cloud.google.com/ → créer un projet
# 2. Activer « YouTube Data API v3 »
# 3. Identifiants → Créer une clé API
#
# Sans cette clé, collect.py ignore la source YouTube et le classement ne
# repose plus que sur une seule source (donc aucune concordance possible).
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=
